---
import { Image } from 'astro:assets';
import award1 from '../images/awards/Alpha Phi Sigma Social Media Proficiency Award.jpg';
import award2 from '../images/awards/Kappa Chi Social Media Proficiency Award.jpg';
---

<section id="awards" class="scroll-mt-20">
  <div class="text-center max-w-2xl mx-auto mb-12 fade-in">
    <div class="inline-flex items-center gap-2 text-akc-gold mb-3">
      <div class="h-px w-6 bg-akc-gold/60"></div>
      <span class="text-xs font-semibold uppercase tracking-widest">Recognition</span>
      <div class="h-px w-6 bg-akc-gold/60"></div>
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl text-akc-light mb-3">Chapter Awards</h2>
    <p class="text-sm text-akc-light/50">Honoring our dedication to communication and program outreach</p>
  </div>

  <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto stagger-children">
    <div class="card-hover relative group rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5 flex flex-col items-center">
      <div class="absolute inset-0 bg-akc-gold/[0.08] rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-400"></div>
      <div class="relative w-full rounded-lg overflow-hidden border-2 border-white/10 shadow-2xl shadow-black/40 bg-white/5 p-3">
        <div class="relative rounded overflow-hidden border border-white/5">
          <Image src={award1} alt="Alpha Phi Sigma Social Media Proficiency Award" class="w-full h-auto object-contain bg-white/5" />
        </div>
      </div>
      <div class="mt-5 text-center relative z-10">
        <h3 class="text-[17px] font-semibold text-gradient">Alpha Phi Sigma Award</h3>
        <p class="text-xs text-akc-light/60 mt-1">Social Media Proficiency Award</p>
      </div>
    </div>

    <div class="card-hover relative group rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5 flex flex-col items-center">
      <div class="absolute inset-0 bg-akc-gold/[0.08] rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-400"></div>
      <div class="relative w-full rounded-lg overflow-hidden border-2 border-white/10 shadow-2xl shadow-black/40 bg-white/5 p-3">
        <div class="relative rounded overflow-hidden border border-white/5">
          <Image src={award2} alt="Kappa Chi Social Media Proficiency Award" class="w-full h-auto object-contain bg-white/5" />
        </div>
      </div>
      <div class="mt-5 text-center relative z-10">
        <h3 class="text-[17px] font-semibold text-gradient">Kappa Chi Chapter</h3>
        <p class="text-xs text-akc-light/60 mt-1">Social Media Proficiency Award</p>
      </div>
    </div>
  </div>
</section>
