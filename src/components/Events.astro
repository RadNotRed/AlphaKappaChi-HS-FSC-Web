---
import events from '../data/events.json';
import { siteConfig } from '../data/siteConfig';
---

<section id="events" class="scroll-mt-24">
  <div class="text-center max-w-3xl mx-auto mb-16 fade-in">
    <div class="inline-flex items-center gap-2 text-akc-gold mb-4">
      <div class="h-px w-8 bg-akc-gold"></div>
      <span class="text-sm font-semibold uppercase tracking-widest">Calendar</span>
      <div class="h-px w-8 bg-akc-gold"></div>
    </div>
    <h2 class="font-serif text-4xl md:text-5xl text-white mb-4">Upcoming Events</h2>
    <p class="text-akc-light/60">Engage with our signature programs and community initiatives</p>
  </div>

  {/* Featured Event */}
  {events && events.find(e => e.featured) && (
    <div class="mb-10 fade-in">
      {(() => {
        const featured = events.find(e => e.featured);
        if (!featured) return null;
        return (
          <div class="group relative glass rounded-3xl border border-akc-gold/30 p-8 md:p-10 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-akc-gold/10 via-akc-gold/5 to-transparent"></div>
            <div class="absolute -top-20 -right-20 w-64 h-64 bg-akc-gold/15 rounded-full blur-3xl group-hover:bg-akc-gold/25 transition-all duration-500"></div>
            <div class="absolute bottom-0 left-0 w-48 h-48 bg-akc-gold/10 rounded-full blur-3xl"></div>

            <div class="relative flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
              <div class="flex-shrink-0">
                <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-gradient-to-br from-akc-gold-dark via-akc-gold to-akc-gold-light flex flex-col items-center justify-center text-akc-dark shadow-xl shadow-akc-gold/30">
                  <span class="text-2xl md:text-3xl font-bold leading-none">{featured.timeframe.split(' ')[1]?.replace(',', '') || featured.timeframe.split(' ')[0]}</span>
                  <span class="text-xs md:text-sm font-semibold uppercase">{featured.timeframe.split(' ')[0]}</span>
                </div>
              </div>

              <div class="flex-1 space-y-3">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-akc-gold/20 text-akc-gold text-xs font-bold uppercase tracking-wider">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                    Featured Event
                  </span>
                </div>
                <h3 class="text-2xl md:text-3xl font-semibold text-white">{featured.title}</h3>
                <p class="text-akc-light/70 text-base md:text-lg leading-relaxed max-w-2xl">{featured.description}</p>
                <div class="flex items-center gap-2 text-akc-gold/80 text-sm pt-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span>{featured.location}</span>
                </div>
              </div>
            </div>
          </div>
        );
      })()}
    </div>
  )}

  {/* Event Cards Grid */}
  <div id="events-grid" class="grid gap-5 md:grid-cols-2 lg:grid-cols-4 stagger-children">
    {events && events.length ? events.filter(e => !e.featured).map((event, idx) => (
      <div data-idx={idx} class="group card-hover glass rounded-2xl border border-white/10 p-5 relative overflow-hidden flex flex-col h-full">
        <div class="absolute top-0 right-0 w-24 h-24 bg-akc-gold/5 rounded-full blur-2xl group-hover:bg-akc-gold/15 transition-all duration-300"></div>

        <div class="relative flex-1">
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-2">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-akc-gold/20 to-akc-gold/10 border border-akc-gold/20 flex items-center justify-center">
                {event.icon === 'scale' && (
                  <svg class="w-5 h-5 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
                )}
                {event.icon === 'heart' && (
                  <svg class="w-5 h-5 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                )}
                {event.icon === 'briefcase' && (
                  <svg class="w-5 h-5 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                )}
                {event.icon === 'book' && (
                  <svg class="w-5 h-5 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                )}
                {(!event.icon || event.icon === 'calendar' || event.icon === 'star') && (
                  <svg class="w-5 h-5 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                )}
              </div>
            </div>
            <span class="text-xs font-semibold text-akc-gold bg-akc-gold/10 px-2.5 py-1 rounded-full">{event.timeframe}</span>
          </div>

          <h3 class="text-lg font-semibold text-white mb-2 group-hover:text-akc-gold transition-colors">{event.title}</h3>
          <p class="text-sm text-akc-light/60 leading-relaxed mb-4">{event.description}</p>
        </div>

        <div class="flex items-center gap-2 text-xs text-akc-light/50 pt-3 border-t border-white/5">
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="truncate">{event.location}</span>
        </div>
      </div>
    )) : (
      <div class="col-span-full rounded-2xl border border-white/10 bg-white/5 p-8 text-center">
        <p class="text-sm text-akc-light/60">No upcoming events.</p>
      </div>
    )}
  </div>

  <div class="text-center mt-8 fade-in">
    <a href={`mailto:${siteConfig.email}`} class="inline-flex items-center gap-2 text-akc-gold font-semibold hover:gap-3 transition-all group">
      <span>Want to suggest an event?</span>
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</section>
