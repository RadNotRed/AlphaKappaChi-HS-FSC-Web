---
import type { ImageMetadata } from 'astro';
import { executiveBoard } from '../data/leadership';

const imageModules = import.meta.glob('../images/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}', {
  eager: true,
});
const bioModules = import.meta.glob('../images/*.txt', {
  eager: true,
  query: '?raw',
  import: 'default',
});

const fileStem = (filePath: string) => filePath.split('/').pop()?.replace(/\.[^/.]+$/, '').toLowerCase() ?? '';
const normalizeKey = (value: string) => value.toLowerCase().replace(/[^a-z0-9]/g, '');

const imagesByKey = new Map<string, string>();
for (const [filePath, mod] of Object.entries(imageModules)) {
  const imageModule = mod as { default?: ImageMetadata | string };
  if (imageModule.default) {
    const resolvedSrc =
      typeof imageModule.default === 'string' ? imageModule.default : imageModule.default.src;
    imagesByKey.set(fileStem(filePath), resolvedSrc);
  }
}

const biosByKey = new Map<string, string>();
for (const [filePath, rawText] of Object.entries(bioModules)) {
  if (typeof rawText === 'string') {
    biosByKey.set(fileStem(filePath), rawText.trim());
  }
}

const membersWithAssets = executiveBoard.map(member => {
  const key = normalizeKey(member.assetKey ?? member.name);
  return {
    ...member,
    image: member.image ?? imagesByKey.get(key),
    bio: member.bio || biosByKey.get(key) || '',
  };
});
---

<section id="leadership" class="scroll-mt-20">
  <div class="fade-in text-center max-w-2xl mx-auto mb-12">
    <div class="inline-flex items-center gap-2 text-akc-gold mb-3">
      <div class="h-px w-6 bg-akc-gold/60"></div>
      <span class="text-xs font-semibold uppercase tracking-widest">Team</span>
      <div class="h-px w-6 bg-akc-gold/60"></div>
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl text-akc-light mb-3">Executive Board</h2>
    <p class="text-sm text-akc-light/50">Meet the leaders driving our mission forward</p>
  </div>

  <div class="stagger-children relative isolate grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
    {membersWithAssets.map(member => (
      <div class="group card-hover relative z-0 overflow-visible rounded-xl border border-white/[0.08] bg-white/[0.02] p-5 text-center hover:z-[9999]">
        <!-- Avatar -->
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-akc-navy to-akc-slate border border-akc-gold/20 flex items-center justify-center group-hover:border-akc-gold/40 transition-colors overflow-hidden">
          {member.image ? (
            <img src={member.image} alt={member.name} class="w-full h-full object-cover" />
          ) : (
            <svg class="w-7 h-7 text-akc-light/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          )}
        </div>
        <p class="text-[11px] font-semibold text-akc-gold uppercase tracking-wider mb-1">{member.role}</p>
        <p class="text-sm font-semibold text-akc-light mb-1">{member.name}</p>

        {member.bio && (
          <>
            <p class="text-xs text-akc-light/55 leading-relaxed md:hidden">{member.bio}</p>
            <div class="pointer-events-none absolute left-1/2 top-1/2 z-[10000] hidden w-[min(28rem,calc(100vw-2rem))] -translate-x-1/2 -translate-y-1/2 origin-center scale-95 isolate overflow-hidden rounded-lg border border-akc-gold/35 bg-akc-navy p-5 text-left opacity-0 shadow-2xl transition-all duration-300 ease-out md:block md:group-hover:pointer-events-auto md:group-hover:scale-100 md:group-hover:opacity-100">
              <div class="mb-3 flex items-center gap-3">
                <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full border border-akc-gold/30 bg-akc-slate/60">
                  {member.image ? (
                    <img src={member.image} alt={member.name} class="h-full w-full object-cover" />
                  ) : (
                    <div class="h-full w-full"></div>
                  )}
                </div>
                <div class="min-w-0">
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-akc-gold">{member.role}</p>
                  <p class="truncate text-base font-semibold text-akc-light">{member.name}</p>
                </div>
              </div>
              <div class="mb-3 h-px w-full bg-akc-gold/30"></div>
              <div class="max-h-[52vh] overflow-y-auto pr-2 [scrollbar-gutter:stable] [scrollbar-width:thin]">
                <p class="text-sm leading-relaxed text-akc-light/90">{member.bio}</p>
              </div>
            </div>
          </>
        )}
      </div>
    ))}
  </div>
</section>


