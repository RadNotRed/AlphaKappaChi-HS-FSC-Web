---
import { siteConfig, navLinks } from '../data/siteConfig';
---

<header id="site-header" class="sticky top-0 z-50 nav-animate">
  <div class="nav-bg border-b border-white/5">
    <div class="max-w-6xl mx-auto px-5">
      <nav class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href="#" class="flex items-center group">
          <div class="">
            <p class="text-sm font-semibold text-akc-light leading-tight">{siteConfig.name}</p>
            <p class="text-[11px] text-akc-light/70 leading-tight">{siteConfig.subtitle}</p>
          </div>
        </a>

        <!-- Desktop links -->
        <div class="hidden lg:flex items-center gap-1">
          {navLinks.map(link => (
            <a href={link.href} class="px-3 py-1.5 text-[13px] text-akc-light/70 hover:text-white rounded-md hover:bg-white/5 transition-all duration-200 font-medium">{link.label}</a>
          ))}
        </div>

        <!-- CTA + hamburger -->
        <div class="flex items-center gap-2">
          <a
            href="#join"
            class="hidden md:inline-flex items-center px-4 py-1.5 text-[13px] font-medium text-akc-light border border-white/10 rounded-lg hover:bg-white/5 hover:text-white transition-all duration-200"
          >
            Apply
          </a>
          <a
            href={siteConfig.donationLink}
            class="hidden sm:inline-flex items-center gap-1.5 px-4 py-1.5 text-[13px] font-semibold text-akc-dark bg-akc-gold rounded-lg hover:bg-akc-gold-light transition-all duration-200 shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            Donate
          </a>

          <!-- Hamburger (mobile) -->
          <button
            id="mobile-menu-btn"
            class="lg:hidden flex flex-col items-center justify-center w-9 h-9 rounded-lg hover:bg-white/5 transition-colors"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <span class="hamburger-line block w-4 h-[1.5px] bg-akc-light/80 rounded-full transition-all duration-300"></span>
            <span class="hamburger-line block w-4 h-[1.5px] bg-akc-light/80 rounded-full mt-1 transition-all duration-300"></span>
            <span class="hamburger-line block w-4 h-[1.5px] bg-akc-light/80 rounded-full mt-1 transition-all duration-300"></span>
          </button>
        </div>
      </nav>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-in-out nav-bg border-b border-white/5"
  >
    <div class="max-w-6xl mx-auto px-5 py-4 space-y-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="mobile-nav-link block px-3 py-2.5 text-sm font-medium text-akc-light/75 hover:text-white hover:bg-white/5 rounded-lg transition-all duration-200"
        >
          {link.label}
        </a>
      ))}
      <div class="border-t border-white/5 pt-3 mt-2 flex gap-2">
        <a
          href="#join"
          class="flex-1 text-center px-4 py-2 text-sm font-medium text-akc-light border border-white/10 rounded-lg hover:bg-white/5 transition-all"
        >
          Apply
        </a>
        <a
          href={siteConfig.donationLink}
          class="flex-1 text-center px-4 py-2 text-sm font-semibold text-akc-dark bg-akc-gold rounded-lg hover:bg-akc-gold-light transition-all"
        >
          Donate
        </a>
      </div>
    </div>
  </div>
</header>


