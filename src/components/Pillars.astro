---
// Four Pillars section
---

<section id="pillars" class="scroll-mt-20">
  <div class="text-center max-w-2xl mx-auto mb-12 fade-in">
    <div class="inline-flex items-center gap-2 text-akc-gold mb-3">
      <div class="h-px w-6 bg-akc-gold/60"></div>
      <span class="text-xs font-semibold uppercase tracking-widest"
        >Foundation</span
      >
      <div class="h-px w-6 bg-akc-gold/60"></div>
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl text-akc-light mb-3">
      Our Four Pillars
    </h2>
    <p class="text-sm text-akc-light/50">
      The core values that guide every member of Kappa Chi
    </p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 stagger-children">
    {
      [
        {
          title: "Academic Excellence",
          desc: "Pursuing academic excellence through research and collaborative learning.",
          icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
        },
        {
          title: "Leadership",
          desc: "Developing tomorrow's leaders through mentorship and real-world experience.",
          icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
        },
        {
          title: "Service",
          desc: "Giving back through community engagement and restorative justice initiatives.",
          icon: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9",
        },
        {
          title: "Unity",
          desc: "Building strong connections and camaraderie among members and the justice community.",
          icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
        },
      ].map((item) => (
        <div class="group relative">
          <div class="absolute inset-0 bg-akc-gold/[0.08] rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-400" />
          <div class="relative card-hover rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6 text-center h-full">
            <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-akc-gold/10 flex items-center justify-center">
              <svg
                class="w-6 h-6 text-akc-gold"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={item.icon}
                />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-gradient mb-2">
              {item.title}
            </h3>
            <p class="text-xs text-akc-light/50 leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
