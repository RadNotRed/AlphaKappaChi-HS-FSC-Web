---
const title = 'Alpha Kappa Chi | Farmingdale State College';
const description = 'Criminal Justice Honor Society at Farmingdale State College, NY';
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      html {
        scroll-behavior: smooth;
      }
      .glass {
        background: rgba(26, 41, 66, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .gold-glow {
        box-shadow: 0 0 40px rgba(212, 165, 53, 0.15);
      }
      .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }
      .text-gradient {
        color: #d4a535;
        background-image: linear-gradient(135deg, #b8922d 0%, #f0d078 50%, #d4a535 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .border-gradient {
        border: 1px solid rgba(212, 165, 53, 0.3);
      }
      @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
      }
      .float {
        animation: float 6s ease-in-out infinite;
      }
    </style>
  </head>
  <body class="bg-akc-dark text-akc-light font-sans antialiased min-h-screen overflow-x-hidden">
    <div class="relative">
      <div class="pointer-events-none fixed inset-0 -z-10">
        <div class="absolute inset-0 bg-gradient-to-br from-akc-dark via-[#0f1f35] to-akc-dark"></div>
        <div class="absolute -left-20 -top-20 h-[600px] w-[600px] rounded-full bg-gradient-radial from-akc-gold/10 via-akc-gold/5 to-transparent blur-3xl"></div>
        <div class="absolute right-0 top-1/4 h-[500px] w-[500px] rounded-full bg-gradient-radial from-akc-navy/50 via-akc-navy/20 to-transparent blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-[400px] w-[400px] rounded-full bg-gradient-radial from-akc-gold/8 via-transparent to-transparent blur-3xl"></div>
      </div>
      <slot />
    </div>
  </body>
</html>
