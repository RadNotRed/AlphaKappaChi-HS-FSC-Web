---
const title = "Alpha Kappa Chi | Alpha Phi Sigma · Farmingdale State College";
const description =
  "Alpha Kappa Chi — the Farmingdale State College chapter of Alpha Phi Sigma, the National Criminal Justice Honor Society.";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink-900: #f8f9fa;
        --ink-700: #d8dee8;
        --ink-500: #a9b3c3;
        --paper-100: #0a1628;
        --paper-200: #0f1f35;
        --brand-700: #1e3a5f;
        --brand-500: #2f5b8f;
        --brand-100: #91a8c9;
        --gold-600: #d4a535;
        --gold-400: #f0d078;
      }

      html {
        scroll-behavior: smooth;
      }

      .nav-bg {
        background: rgba(10, 22, 40, 0.88);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
      }

      .glass {
        background: rgba(26, 41, 66, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .gold-glow {
        box-shadow: 0 16px 40px rgba(219, 182, 102, 0.2);
      }

      .card-hover {
        transition:
          transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
          box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 36px rgba(0, 0, 0, 0.35);
      }

      .text-gradient {
        background-image: linear-gradient(
          120deg,
          #b8922d 0%,
          #f0d078 42%,
          #d4a535 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .border-gradient {
        border: 1px solid rgba(212, 165, 53, 0.25);
      }

      .leader-name {
        white-space: normal;
        word-break: break-word;
      }

      @keyframes float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-8px);
        }
      }
      .float {
        animation: float 6s ease-in-out infinite;
      }

      @keyframes hero-fade-up {
        from {
          opacity: 0;
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes hero-fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes hero-scale-in {
        from {
          opacity: 0;
          transform: scale(0.95);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      .hero-animate {
        animation: hero-fade-up 0.7s cubic-bezier(0.4, 0, 0.2, 1) both;
      }
      .hero-animate-delay-1 { animation-delay: 0.1s; }
      .hero-animate-delay-2 { animation-delay: 0.15s; }
      .hero-animate-delay-3 { animation-delay: 0.2s; }
      .hero-animate-delay-4 { animation-delay: 0.3s; }
      .hero-animate-delay-5 { animation-delay: 0.4s; }
      .hero-card-animate {
        animation: hero-scale-in 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.25s both;
      }

      .nav-animate {
        animation: hero-fade-in 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
      }

      .section-heading {
        color: var(--ink-900);
      }

      .section-copy {
        color: var(--ink-700);
      }

      .soft-surface {
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-animate,
        .hero-card-animate,
        .nav-animate,
        .float {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body
    class="bg-akc-dark text-akc-light font-sans antialiased min-h-screen overflow-x-hidden"
  >
    <div class="relative">
      <div class="pointer-events-none fixed inset-0 -z-10">
        <div class="absolute inset-0 bg-gradient-to-br from-akc-dark via-[#0f1f35] to-akc-dark">
        </div>
        <div
          class="absolute -left-20 -top-20 h-[600px] w-[600px] rounded-full bg-gradient-radial from-akc-gold/10 via-akc-gold/5 to-transparent blur-3xl"
        >
        </div>
        <div
          class="absolute right-0 top-1/4 h-[500px] w-[500px] rounded-full bg-gradient-radial from-akc-navy/50 via-akc-navy/20 to-transparent blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-0 left-1/4 h-[400px] w-[400px] rounded-full bg-gradient-radial from-akc-gold/8 via-transparent to-transparent blur-3xl"
        >
        </div>
        <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(rgba(255,255,255,0.14) 0.7px, transparent 0.7px); background-size: 24px 24px;"></div>
      </div>
      <slot />
    </div>

    <script is:inline>
      (function () {
        /* ── Scroll-based entrance animations ── */
        function hideElement(el, type) {
          el.style.opacity = "0";
          el.style.transition = "none";
          if (type === "fade-in") {
            el.style.transform = "translateY(24px)";
          } else if (type === "fade-in-left") {
            el.style.transform = "translateX(-30px)";
          } else if (type === "fade-in-right") {
            el.style.transform = "translateX(30px)";
          } else if (type === "scale-in") {
            el.style.transform = "scale(0.92)";
          }
        }

        function showElement(el, type, delay) {
          setTimeout(function () {
            el.style.transition =
              "opacity 0.45s ease-out, transform 0.45s ease-out";
            el.style.opacity = "1";
            el.style.transform = "translateY(0) translateX(0) scale(1)";
          }, delay);
        }

        function initAnimations() {
          var fadeIn = document.querySelectorAll(".fade-in");
          var fadeInLeft = document.querySelectorAll(".fade-in-left");
          var fadeInRight = document.querySelectorAll(".fade-in-right");
          var scaleIn = document.querySelectorAll(".scale-in");
          var staggerChildren = document.querySelectorAll(".stagger-children");

          fadeIn.forEach(function (el) { hideElement(el, "fade-in"); });
          fadeInLeft.forEach(function (el) { hideElement(el, "fade-in-left"); });
          fadeInRight.forEach(function (el) { hideElement(el, "fade-in-right"); });
          scaleIn.forEach(function (el) { hideElement(el, "scale-in"); });
          staggerChildren.forEach(function (parent) {
            var children = parent.children;
            for (var i = 0; i < children.length; i++) {
              hideElement(children[i], "fade-in");
            }
          });

          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  var el = entry.target;
                  if (el.classList.contains("stagger-children")) {
                    var children = el.children;
                    for (var i = 0; i < children.length; i++) {
                      showElement(children[i], "fade-in", i * 60);
                    }
                  } else if (el.classList.contains("fade-in")) {
                    showElement(el, "fade-in", 0);
                  } else if (el.classList.contains("fade-in-left")) {
                    showElement(el, "fade-in-left", 0);
                  } else if (el.classList.contains("fade-in-right")) {
                    showElement(el, "fade-in-right", 0);
                  } else if (el.classList.contains("scale-in")) {
                    showElement(el, "scale-in", 0);
                  }
                  observer.unobserve(el);
                }
              });
            },
            { threshold: 0.1, rootMargin: "0px 0px -80px 0px" },
          );

          fadeIn.forEach(function (el) { observer.observe(el); });
          fadeInLeft.forEach(function (el) { observer.observe(el); });
          fadeInRight.forEach(function (el) { observer.observe(el); });
          scaleIn.forEach(function (el) { observer.observe(el); });
          staggerChildren.forEach(function (el) { observer.observe(el); });
        }

        /* ── Mobile hamburger menu ── */
        function initMobileMenu() {
          var btn = document.getElementById("mobile-menu-btn");
          var menu = document.getElementById("mobile-menu");
          if (!btn || !menu) return;

          var isOpen = false;
          btn.addEventListener("click", function () {
            isOpen = !isOpen;
            btn.setAttribute("aria-expanded", String(isOpen));
            if (isOpen) {
              menu.style.maxHeight = menu.scrollHeight + "px";
              menu.style.opacity = "1";
            } else {
              menu.style.maxHeight = "0";
              menu.style.opacity = "0";
            }
            // Animate hamburger lines
            var lines = btn.querySelectorAll(".hamburger-line");
            if (lines.length === 3) {
              if (isOpen) {
                lines[0].style.transform = "translateY(8px) rotate(45deg)";
                lines[1].style.opacity = "0";
                lines[2].style.transform = "translateY(-8px) rotate(-45deg)";
              } else {
                lines[0].style.transform = "";
                lines[1].style.opacity = "1";
                lines[2].style.transform = "";
              }
            }
          });

          // Close menu when clicking a nav link
          var links = menu.querySelectorAll(".mobile-nav-link");
          links.forEach(function (link) {
            link.addEventListener("click", function () {
              isOpen = false;
              btn.setAttribute("aria-expanded", "false");
              menu.style.maxHeight = "0";
              menu.style.opacity = "0";
              var lines = btn.querySelectorAll(".hamburger-line");
              if (lines.length === 3) {
                lines[0].style.transform = "";
                lines[1].style.opacity = "1";
                lines[2].style.transform = "";
              }
            });
          });
        }

        /* ── Boot ── */
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            initAnimations();
            initMobileMenu();
          });
        } else {
          initAnimations();
          initMobileMenu();
        }
      })();
    </script>
  </body>
</html>

