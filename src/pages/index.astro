---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Pillars from '../components/Pillars.astro';
import Farmingdale from '../components/Farmingdale.astro';
import Awards from '../components/Awards.astro';
import Events from '../components/Events.astro';
import Membership from '../components/Membership.astro';
import Leadership from '../components/Leadership.astro';
import Presidents from '../components/Presidents.astro';
import Donate from '../components/Donate.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Navbar />
  <Hero />
  <main class="max-w-6xl mx-auto px-5 pb-24 space-y-24 md:space-y-28">
    <About />
    <Pillars />
    <Farmingdale />
    <Awards />
    <Events />
    <Membership />
    <Leadership />
    <Presidents />
    <Donate />
  </main>
  <Footer />
</Base>

