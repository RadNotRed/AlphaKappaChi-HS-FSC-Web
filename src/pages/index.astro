---
import Base from '../layouts/Base.astro';
import events from '../data/events.json';

const donationLink = 'https://example.com/donate/akc-fsc';
---
<Base>
    <!-- nav -->
  <header class="sticky top-0 z-50 nav-animate">
    <div class="max-w-7xl mx-auto px-6 pt-6">
      <nav class="glass flex items-center justify-between gap-4 rounded-2xl border border-white/10 px-6 py-4 gold-glow">
        <div class="flex items-center gap-4">
          <!-- logo -->
          <div class="relative group">
            <div class="absolute inset-0 bg-akc-gold/30 rounded-xl blur-md group-hover:blur-lg transition-all"></div>
            <div class="relative flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br from-akc-gold-dark via-akc-gold to-akc-gold-light text-akc-dark font-bold text-lg shadow-lg">
              AKX
            </div>
          </div>
          <div class="hidden sm:block">
            <p class="text-sm font-semibold tracking-wide text-gradient">Alpha Kappa Chi</p>
            <p class="text-xs text-akc-light/60">Criminal Justice Honor Society</p>
          </div>
        </div>
        <div class="hidden lg:flex items-center gap-6 text-sm">
          <a href="#about" class="text-akc-light/70 hover:text-white transition-colors duration-200 font-medium">About</a>
          <a href="#pillars" class="text-akc-light/70 hover:text-white transition-colors duration-200 font-medium">Pillars</a>
          <a href="#events" class="text-akc-light/70 hover:text-white transition-colors duration-200 font-medium">Events</a>
          <a href="#join" class="text-akc-light/70 hover:text-white transition-colors duration-200 font-medium">Membership</a>
          <a href="#leadership" class="text-akc-light/70 hover:text-white transition-colors duration-200 font-medium">Leadership</a>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="#join"
            class="hidden md:inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-sm font-medium text-white hover:bg-white/10 hover:border-white/30 transition-all duration-200"
          >
            Apply Now
          </a>
          <a
            href={donationLink}
            class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-akc-gold-dark via-akc-gold to-akc-gold-light px-5 py-2.5 text-sm font-semibold text-akc-dark shadow-lg shadow-akc-gold/25 hover:shadow-akc-gold/40 hover:scale-[1.02] transition-all duration-200"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            Donate
          </a>
        </div>
      </nav>
    </div>
  </header>

  <!-- hero header -->
  <section class="relative min-h-[90vh] flex items-center pt-8 pb-20">
    <div class="max-w-7xl mx-auto px-6 w-full">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="space-y-8">
          <div class="inline-flex items-center gap-3 rounded-full border-gradient px-5 py-2.5 hero-animate hero-animate-delay-1">
            <div class="h-2 w-2 rounded-full bg-akc-gold animate-pulse"></div>
            <span class="text-sm font-medium text-akc-light/90">Farmingdale State College · New York</span>
          </div>
          
          <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl leading-[1.1] text-white hero-animate hero-animate-delay-2">
            Advancing <span class="text-gradient">Justice</span> Through Excellence
          </h1>
          
          <p class="text-lg md:text-xl text-akc-light/70 max-w-xl leading-relaxed hero-animate hero-animate-delay-3">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          </p>
          
          <div class="flex flex-wrap gap-4 pt-2 hero-animate hero-animate-delay-4">
            <a
              href="#join"
              class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-akc-gold-dark via-akc-gold to-akc-gold-light px-7 py-4 text-sm font-semibold text-akc-dark shadow-lg shadow-akc-gold/25 hover:shadow-akc-gold/40 hover:scale-[1.02] transition-all duration-200"
            >
              Begin Your Journey
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
            <a
              href="#about"
              class="inline-flex items-center gap-2 rounded-full border border-white/20 px-7 py-4 text-sm font-semibold text-white hover:bg-white/10 hover:border-white/30 transition-all duration-200"
            >
              Learn More
            </a>
          </div>
          
          <!-- stats -->
          <div class="grid grid-cols-3 gap-6 pt-8 border-t border-white/10 hero-animate hero-animate-delay-5">
            <div>
              <p class="text-3xl md:text-4xl font-bold text-gradient">3.25+</p>
              <p class="text-xs uppercase tracking-wider text-akc-light/50 mt-1">Min. GPA</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-bold text-white">50+</p>
              <p class="text-xs uppercase tracking-wider text-akc-light/50 mt-1">Service Hours</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-bold text-white">2024</p>
              <p class="text-xs uppercase tracking-wider text-akc-light/50 mt-1">Founded</p>
            </div>
          </div>
        </div>

        <!-- hero card-->
        <div class="relative float hero-card-animate">
          <div class="absolute -inset-4 bg-gradient-to-r from-akc-gold/15 via-akc-gold-light/10 to-akc-gold/15 rounded-[2rem] blur-2xl"></div>
          <div class="relative glass rounded-3xl border border-akc-gold/20 p-8 gold-glow">
            <div class="flex justify-center mb-8">
              <div class="relative">
                <div class="absolute inset-0 bg-akc-gold/25 rounded-full blur-xl"></div>
                <div class="relative w-32 h-32 rounded-full bg-gradient-to-br from-akc-navy via-akc-slate to-akc-navy border-4 border-akc-gold/60 flex items-center justify-center">
                  <div class="text-center">
                    <p class="text-2xl font-bold text-gradient">AKX</p>
                    <p class="text-[10px] uppercase tracking-widest text-akc-light/60">Est. 2024</p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="space-y-4">
              <div class="card-hover rounded-2xl border border-white/10 bg-white/5 p-5">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 rounded-lg bg-akc-gold/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                  </div>
                  <p class="text-sm font-semibold text-white">Academic Excellence</p>
                </div>
                <p class="text-sm text-akc-light/60">Blah blah blah</p>
              </div>
              
              <div class="card-hover rounded-2xl border border-white/10 bg-white/5 p-5">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 rounded-lg bg-akc-gold/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                  </div>
                  <p class="text-sm font-semibold text-white">Community Service</p>
                </div>
                <p class="text-sm text-akc-light/60">Blah blah blah</p>
              </div>
              
              <div class="card-hover rounded-2xl border border-white/10 bg-white/5 p-5">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 rounded-lg bg-akc-gold/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <p class="text-sm font-semibold text-white">Career Development</p>
                </div>
                <p class="text-sm text-akc-light/60">Blah blah blah</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- main -->
  <main class="max-w-7xl mx-auto px-6 pb-24 space-y-32">
    
    <!-- about -->
    <section id="about" class="scroll-mt-24">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="space-y-6 fade-in-left">
          <div class="inline-flex items-center gap-2 text-akc-gold">
            <div class="h-px w-12 bg-akc-gold"></div>
            <span class="text-sm font-semibold uppercase tracking-widest">Our Mission</span>
          </div>
          <h2 class="font-serif text-4xl md:text-5xl text-white leading-tight">
            Scholarship. Integrity.<br/>
            <span class="text-gradient">Service to Community.</span>
          </h2>
          <p class="text-lg text-akc-light/70 leading-relaxed">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur non nulla sit amet nisl tempus convallis quis ac lectus. Mauris blandit aliquet elit, eget tincidunt nibh pulvinar a.
          </p>
          <div class="pt-4">
            <a href="#join" class="inline-flex items-center gap-2 text-akc-gold font-semibold hover:gap-3 transition-all">
              Become a member
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
        
        <div class="grid gap-4 sm:grid-cols-2 stagger-children">
          <div class="card-hover glass rounded-2xl border border-white/10 p-6 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-akc-gold/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-white">Academic Excellence</h3>
            <p class="text-sm text-akc-light/60">Peer-led research circles, writing labs, and moot-court prep with faculty mentors.</p>
          </div>
          
          <div class="card-hover glass rounded-2xl border border-white/10 p-6 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-akc-gold/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-white">Professional Growth</h3>
            <p class="text-sm text-akc-light/60">Agency visits, resume workshops, and panels with alumni in law enforcement.</p>
          </div>
          
          <div class="card-hover glass rounded-2xl border border-white/10 p-6 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-akc-gold/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-white">Community Impact</h3>
            <p class="text-sm text-akc-light/60">Service projects across Long Island focused on youth outreach and restorative practices.</p>
          </div>
          
          <div class="card-hover glass rounded-2xl border border-white/10 p-6 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-akc-gold/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-white">Field Experience</h3>
            <p class="text-sm text-akc-light/60">Courtroom visits, simulation labs, and hands-on training with local agencies.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- pillars -->
    <section id="pillars" class="scroll-mt-24">
      <div class="text-center max-w-3xl mx-auto mb-16 fade-in">
        <div class="inline-flex items-center gap-2 text-akc-gold mb-4">
          <div class="h-px w-8 bg-akc-gold"></div>
          <span class="text-sm font-semibold uppercase tracking-widest">Foundation</span>
          <div class="h-px w-8 bg-akc-gold"></div>
        </div>
        <h2 class="font-serif text-4xl md:text-5xl text-white mb-4">Our Four Pillars</h2>
        <p class="text-akc-light/60">The core values that guide every member of Alpha Kappa Chi</p>
      </div>
      
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 stagger-children">
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-b from-akc-gold/20 to-transparent rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative card-hover glass rounded-3xl border border-white/10 p-8 text-center h-full">
            <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-akc-gold/30 to-akc-gold/10 flex items-center justify-center">
              <svg class="w-8 h-8 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gradient mb-3">Integrity</h3>
            <p class="text-sm text-akc-light/60 leading-relaxed">Upholding the highest ethical standards in scholarship and service to justice.</p>
          </div>
        </div>
        
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-b from-akc-gold/20 to-transparent rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative card-hover glass rounded-3xl border border-white/10 p-8 text-center h-full">
            <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-akc-gold/30 to-akc-gold/10 flex items-center justify-center">
              <svg class="w-8 h-8 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gradient mb-3">Leadership</h3>
            <p class="text-sm text-akc-light/60 leading-relaxed">Developing tomorrow's leaders through mentorship and real-world experience.</p>
          </div>
        </div>
        
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-b from-akc-gold/20 to-transparent rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative card-hover glass rounded-3xl border border-white/10 p-8 text-center h-full">
            <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-akc-gold/30 to-akc-gold/10 flex items-center justify-center">
              <svg class="w-8 h-8 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gradient mb-3">Scholarship</h3>
            <p class="text-sm text-akc-light/60 leading-relaxed">Pursuing academic excellence through research and collaborative learning.</p>
          </div>
        </div>
        
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-b from-akc-gold/20 to-transparent rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative card-hover glass rounded-3xl border border-white/10 p-8 text-center h-full">
            <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-akc-gold/30 to-akc-gold/10 flex items-center justify-center">
              <svg class="w-8 h-8 text-akc-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gradient mb-3">Service</h3>
            <p class="text-sm text-akc-light/60 leading-relaxed">Giving back through community engagement and restorative justice initiatives.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- farmingdale connection -->
    <section class="relative overflow-hidden scale-in">
      <div class="absolute inset-0 bg-gradient-to-r from-akc-navy/50 to-akc-slate/50 rounded-[2.5rem]"></div>
      <div class="absolute inset-0 opacity-30">
        <div class="absolute top-0 right-0 w-96 h-96 bg-akc-gold/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-72 h-72 bg-akc-navy/30 rounded-full blur-3xl"></div>
      </div>
      <div class="relative glass rounded-[2.5rem] border border-white/10 p-10 md:p-14">
        <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:items-center">
          <div class="space-y-6 fade-in-left">
            <div class="inline-flex items-center gap-2 text-akc-gold">
              <div class="h-px w-12 bg-akc-gold"></div>
              <span class="text-sm font-semibold uppercase tracking-widest">Our Home</span>
            </div>
            <h2 class="font-serif text-4xl md:text-5xl text-white leading-tight">
              Rooted in <span class="text-gradient">Farmingdale</span>
            </h2>
            <p class="text-lg text-akc-light/70 leading-relaxed">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum ac diam sit amet quam vehicula elementum sed sit amet dui. Praesent sapien massa, convallis a pellentesque nec.
            </p>
            <div class="grid gap-4 sm:grid-cols-2 pt-4">
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p class="text-lg font-semibold text-white mb-1">Field Ready</p>
                <p class="text-sm text-akc-light/60">Mock incident command, crisis communication, and evidence handling.</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p class="text-lg font-semibold text-white mb-1">Civic Engagement</p>
                <p class="text-sm text-akc-light/60">Youth mentorship and restorative justice workshops.</p>
              </div>
            </div>
          </div>
          
          <div class="glass rounded-2xl border border-white/10 p-6">
            <p class="text-sm font-semibold text-akc-gold mb-4">Program Highlights</p>
            <ul class="space-y-4">
